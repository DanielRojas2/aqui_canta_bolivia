APP_NAME="Aquí Canta Bolivia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:9080

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# =========================================================================
# Puertos y Enlace de Red (Docker Compose - Servidor Debian 13)
# =========================================================================
# Si usas Nginx/Apache en el host como proxy inverso, cambia *_BIND_IP a 127.0.0.1
APP_BIND_IP=0.0.0.0
APP_EXTERNAL_PORT=9080

REVERB_BIND_IP=0.0.0.0
REVERB_EXTERNAL_PORT=6080

DB_BIND_IP=127.0.0.1
DB_EXTERNAL_PORT=3307

PMA_BIND_IP=127.0.0.1
PMA_EXTERNAL_PORT=9086

# =========================================================================
# Base de Datos MySQL 8.0 (Contenedor acb_mysql)
# =========================================================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=festival_acb
DB_USERNAME=acb_app
DB_PASSWORD=CAMBIA_ESTA_PASSWORD_SEGURA
MYSQL_ROOT_PASSWORD=CAMBIA_ESTA_ROOT_PASSWORD_SEGURA

# Automatización inicial al arrancar el contenedor app
RUN_MIGRATIONS=true
RUN_SEEDERS=true

# =========================================================================
# Drivers de Sesión, Caché, Colas y WebSockets
# =========================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# =========================================================================
# Laravel Reverb (Comunicación interna Backend -> ws://reverb:6080)
# =========================================================================
REVERB_APP_ID=935767
REVERB_APP_KEY=CAMBIA_ESTA_APP_KEY
REVERB_APP_SECRET=CAMBIA_ESTE_APP_SECRET
REVERB_HOST=reverb
REVERB_PORT=6080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6080

# Variables Vite para el navegador cliente
# - Acceso directo por IP:9080 -> VITE_REVERB_PORT=6080 y VITE_REVERB_SCHEME=http
# - Detrás de Nginx/Apache con HTTPS (443) -> VITE_REVERB_PORT=443 y VITE_REVERB_SCHEME=https
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_PORT="${REVERB_EXTERNAL_PORT}"
VITE_REVERB_SCHEME=http

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
