FROM php:8.2-fpm-bookworm

ENV DEBIAN_FRONTEND=noninteractive

# Instalar dependencias del sistema, Nginx, Supervisor, extensiones PHP y cliente MySQL
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    supervisor \
    curl \
    ca-certificates \
    gnupg \
    git \
    unzip \
    zip \
    default-mysql-client \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libzip-dev \
    libonig-dev \
    libicu-dev \
    libxml2-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo_mysql \
        mbstring \
        zip \
        exif \
        pcntl \
        bcmath \
        gd \
        intl \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Instalar Composer 2 oficial
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copiar código de la aplicación (sin dependencias locales ni .env local)
COPY . /var/www/html
RUN rm -rf /var/www/html/vendor /var/www/html/node_modules /var/www/html/.env

# Instalar dependencias PHP de producción
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader

# Variables de build para Vite (Reverb detrás de HTTPS en Koyeb puerto 443)
ARG VITE_APP_NAME="Aquí Canta Bolivia"
ARG VITE_REVERB_APP_KEY=rlml9nwlxkswhus5t6ca
ARG VITE_REVERB_PORT=443
ARG VITE_REVERB_SCHEME=https

ENV VITE_APP_NAME="${VITE_APP_NAME}" \
    VITE_REVERB_APP_KEY="${VITE_REVERB_APP_KEY}" \
    VITE_REVERB_PORT="${VITE_REVERB_PORT}" \
    VITE_REVERB_SCHEME="${VITE_REVERB_SCHEME}"

# Compilar assets Vite y eliminar node_modules para mantener la imagen liviana
RUN npm ci --no-audit --no-fund \
    && npm run build \
    && rm -rf node_modules

# Preparar directorios y permisos de Laravel
RUN mkdir -p storage/framework/sessions storage/framework/views storage/framework/cache storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

# Configurar Nginx, Supervisor y Entrypoint para Koyeb
COPY docker/koyeb/nginx.conf /etc/nginx/sites-available/default
RUN ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default
COPY docker/koyeb/supervisord.conf /etc/supervisor/conf.d/acb.conf
COPY docker/koyeb/entrypoint.sh /usr/local/bin/koyeb-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/koyeb-entrypoint.sh \
    && chmod +x /usr/local/bin/koyeb-entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/koyeb-entrypoint.sh"]
