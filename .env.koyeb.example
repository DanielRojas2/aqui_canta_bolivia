# Variables de entorno recomendadas para configurar en el panel de Koyeb
# (NO subir este archivo con credenciales reales al repositorio)

APP_NAME="Aquí Canta Bolivia"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERAR_CON_php_artisan_key_generate_show
APP_URL=https://tu-app.koyeb.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# Base de datos MySQL externa gratuita (ej. TiDB Cloud Serverless o Aiven)
DB_CONNECTION=mysql
DB_HOST=tu-host-tidb-o-aiven
DB_PORT=4000
DB_DATABASE=festival_acb
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_password
# En TiDB Cloud / Aiven con SSL obligatorio, apuntar al certificado del sistema Debian:
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
CACHE_STORE=database
# En Koyeb Free (512 MB RAM) se recomienda 'sync' para ahorrar memoria
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=reverb

# Reverb interno (Nginx hace proxy de /app hacia 127.0.0.1:6080)
REVERB_APP_ID=935767
REVERB_APP_KEY=rlml9nwlxkswhus5t6ca
REVERB_APP_SECRET=cambia_este_secret_en_koyeb
REVERB_HOST=127.0.0.1
REVERB_PORT=6080
REVERB_SCHEME=http

# Variables usadas en el build de Vite (Docker Build Args / Env en Koyeb)
VITE_REVERB_APP_KEY=rlml9nwlxkswhus5t6ca
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Control de arranque en Koyeb (puedes poner false luego del primer despliegue)
RUN_MIGRATIONS=true
RUN_SEEDERS=true
